# Copy this file to .env and fill in your values.

# Ollama Cloud API key (required) — https://ollama.com
OLLAMA_API_KEY=your_api_key_here

# Telegram delivery (only needed when config.yaml telegram.enabled: true)
# Bot token from @BotFather; chat id of the target chat/channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
