# Скопируйте в .env и заполните. Файл читается из корня проекта (или из HUB_ROOT / NEWS_DIGEST_ROOT).

# ── Модель ────────────────────────────────────────────────────────────────────
# Ключ Ollama Cloud (ollama.com → Settings → Keys). Нужен и обработке карточек
# (`python -m src process`), и классификации дайджеста (`python -m news_digest run`).
OLLAMA_API_KEY=

# ── Сбор источников (src/) ────────────────────────────────────────────────────
# Tavily — поиск источников (`discover`) и поисковые запросы (`search`)
TAVILY_API=
# api_id / api_hash с https://my.telegram.org → раздел API development tools (MTProto для каналов)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Доставка дайджеста в Telegram (news_digest/) ──────────────────────────────
# Нужны только при config.yaml → telegram.enabled: true (или telegram.alerts: true).
# Токен бота из @BotFather; id чата или канала, куда слать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── HTTP-API (`python -m src serve`, docker compose) — читает `Settings` в src/config.py ──
# ENVIRONMENT=local            # local | dev | prod; local включает автоперезапуск в `python -m src.main`
# HOST=127.0.0.1               # в контейнере — 0.0.0.0
# PORT=8000
# DOCS=true                    # отдавать /docs и /openapi.json
# CORS_ORIGINS=["*"]           # JSON-список источников фронтенда
# LOG_LEVEL=INFO
# Корень данных задаётся только переменной окружения HUB_ROOT (строка в .env не читается).
